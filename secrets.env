HF_PROVIDER=auto

# ============================================================
# LLM backend selection
# ============================================================
# LLM_BACKEND: "local" = load weights from disk (compute node, no internet)
#              "ollama" = delegate to local Ollama daemon (dev/fallback)
#              "hf_api" = delegate to HuggingFace Inference API (requires HF_TOKEN)
LLM_BACKEND=ollama

# LLM_MODEL_KEY: key from MODEL_REGISTRY in llm_backend.py
# Choose ONE of:
#   jsl_medllama_3_8b   johnsnowlabs/JSL-MedLlama-3-8B-v2.0                 (default, ~20GB VRAM)
#   bio_llama_3_8b      ContactDoctor/Bio-Medical-Llama-3-8B-CoT-012025     (~16GB VRAM)
#   meditron_7b         epfl-llm/meditron-7b                                (~16GB VRAM)
#   meditron_70b        epfl-llm/meditron-70b                               (~80GB VRAM, needs A100)
#   biom_mistral_7b     BioMistral/BioMistral-7B                            (~16GB VRAM)
#   pmc_llama_13b       axiong/PMC_LLaMA_13B                                (~28GB VRAM, gated)
#   llama3_8b           meta-llama/Llama-3.1-8B-Instruct                    (~20GB VRAM, gated)
#   llama3_70b          meta-llama/Llama-3.1-70B-Instruct                   (~80GB VRAM, gated)
LLM_MODEL_KEY=llama3_8b

# Base directory where model weights are stored (one sub-folder per model key)
LLM_LOCAL_DIR=/content/drive/MyDrive/Colab Notebooks/CoDHy/models

# Optional: force a specific device ("cuda", "cuda:0", "cpu"). Leave blank for auto-detect.
# LLM_DEVICE=cuda

# ============================================================
# Ollama settings (only used when LLM_BACKEND=ollama)
# ============================================================
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/api/generate

# ============================================================
# PubMed cache directory (pre-fetched on login node)
# ============================================================
PUBMED_CACHE_DIR=/content/drive/MyDrive/Colab Notebooks/CoDHy/data_cache/pubmed